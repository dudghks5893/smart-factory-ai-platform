APP_ENV=local
LOG_LEVEL=INFO
PATCHCORE_ARTIFACT_DIR=artifacts/models/patchcore/<artifact-id>
PATCHCORE_THRESHOLDS_PATH=outputs/evaluation/patchcore/thresholds/<threshold-id>/thresholds.json
MODEL_DEVICE=auto
MAX_UPLOAD_BYTES=10485760
DATABASE_URL=postgresql+psycopg://smartfactory:change-me@localhost:5432/smartfactory
POSTGRES_USER=smartfactory
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=smartfactory
API_PORT=8000
PATCHCORE_ARTIFACT_DIR_HOST=./artifacts/models/patchcore/<artifact-id>
PATCHCORE_THRESHOLDS_PATH_HOST=./outputs/evaluation/patchcore/thresholds/<threshold-id>/thresholds.json
MLFLOW_TRACKING_URI=sqlite:///outputs/mlflow/mlflow.db
MLFLOW_EXPERIMENT_NAME=smartfactory-patchcore
# Local monitoring example values only; production must use managed secrets and private access.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
# Dashboard uses the Compose service hostname for API access and a browser-accessible Grafana URL.
DASHBOARD_API_BASE_URL=http://api:8000
DRIFT_REPORT_DIR=outputs/drift/patchcore
DRIFT_REPORT_DIR_HOST=./outputs/drift/patchcore
GRAFANA_URL=http://localhost:3000
DASHBOARD_REQUEST_TIMEOUT_SECONDS=5
DASHBOARD_PORT=8501
# RAG index/artifact and external provider placeholders; never commit real private SOPs or keys.
RAG_INDEX_DIR_HOST=./artifacts/rag/manuals/<index-id>
RAG_TOP_K=5
RAG_MAX_TOP_K=10
RAG_MIN_RETRIEVAL_SCORE=0.2
RAG_REQUEST_TIMEOUT_SECONDS=30
RAG_EMBEDDING_PROVIDER=openai-compatible
RAG_EMBEDDING_MODEL=text-embedding-model
RAG_GENERATION_PROVIDER=openai-compatible
RAG_GENERATION_MODEL=generation-model
RAG_PROVIDER_API_BASE_URL=https://api.openai.com/v1
RAG_PROVIDER_API_KEY=replace-with-secret
RAG_PORT=8001
