# GCP L4 single-VM deployment example.
# Copy this file outside the repository and replace every secret placeholder.
#
# Runtime artifacts are pinned to the immutable v1 restore directory rather
# than the mutable `current` symlink.

IMAGE_TAG=gcp-l4

POSTGRES_USER=smartfactory
POSTGRES_PASSWORD=replace-with-long-random-secret
POSTGRES_DB=smartfactory
POSTGRES_PORT=5432

API_PORT=8000
PATCHCORE_ARTIFACT_DIR_HOST=/home/dudghks5893/smart-factory-ai-runtime/smartfactory-deployment-runtime-l4-v1/patchcore/model
PATCHCORE_THRESHOLDS_PATH_HOST=/home/dudghks5893/smart-factory-ai-runtime/smartfactory-deployment-runtime-l4-v1/patchcore/thresholds/thresholds.json
MODEL_DEVICE=cuda
YOLO_SEGMENTATION_ENABLED=true
YOLO_SEGMENTATION_ARTIFACT_DIR_HOST=/home/dudghks5893/smart-factory-ai-runtime/smartfactory-deployment-runtime-l4-v1/yolo_segmentation
YOLO_SEGMENTATION_DEVICE=cuda
YOLO_SEGMENTATION_CONFIDENCE=0.25
MAX_UPLOAD_BYTES=10485760

PROMETHEUS_PORT=9090

GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-long-random-secret

DASHBOARD_API_BASE_URL=http://api:8000
DRIFT_REPORT_DIR_HOST=./outputs/drift/patchcore
GRAFANA_URL=http://localhost:3000
DASHBOARD_REQUEST_TIMEOUT_SECONDS=5
DASHBOARD_PORT=8501
